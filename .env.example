# Community platform — development environment template.
# Copy to .env (`cp .env.example .env`) and adjust for local development.
# Contains SAFE PLACEHOLDERS ONLY. Never put real secrets in this file.

# --- Runtime ---
# development | production. Controls OpenAPI docs exposure, among other things.
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_DB=community
POSTGRES_USER=community
POSTGRES_PASSWORD=change-me-in-local-dev

# Connection string used by the backend/worker to reach the db service.
DATABASE_URL=postgresql+psycopg://community:change-me-in-local-dev@db:5432/community

# Separate database on the SAME PostgreSQL service, used by integration tests.
# Must point at a DIFFERENT database than DATABASE_URL; integration tests refuse
# to run if they resolve to the same database and never fall back to DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://community:change-me-in-local-dev@db:5432/community_test

# --- API ---
API_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# Base URL the frontend uses to reach the backend API. Typed configuration seam.
VITE_API_BASE_URL=http://localhost:8000

# Backend target for the Vite dev proxy of /api. In Docker Compose this is the
# service name; for host-based dev use http://localhost:8000.
VITE_API_PROXY_TARGET=http://api:8000

# --- GitHub OAuth (authentication) ---
# Create a GitHub OAuth App and set these. Authentication fails closed with a
# clear error until both the id and secret are configured. NEVER commit real
# secrets; put real values only in your local .env.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must match the OAuth App's Authorization callback URL (same origin as the
# frontend, proxied to the backend).
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# --- Sessions ---
# Absolute session lifetime in seconds (default 14 days).
SESSION_TTL_SECONDS=1209600
