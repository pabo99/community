# Community platform — development environment template.
# Copy to .env (`cp .env.example .env`) and adjust for local development.
# Contains SAFE PLACEHOLDERS ONLY. Never put real secrets in this file.

# --- Runtime ---
# development | production. Controls OpenAPI docs exposure, among other things.
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_DB=community
POSTGRES_USER=community
POSTGRES_PASSWORD=change-me-in-local-dev

# Connection string used by the backend/worker to reach the db service.
DATABASE_URL=postgresql+psycopg://community:change-me-in-local-dev@db:5432/community

# --- API ---
API_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
